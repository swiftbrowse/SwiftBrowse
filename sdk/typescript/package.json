{
  "name": "swiftbrowse",
  "version": "0.1.2",
  "description": "The AI browser for browser automation and end-to-end testing: JavaScript/TypeScript SDK",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "bin"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "test": "node --test"
  },
  "bin": {
    "swiftbrowse": "bin/swiftbrowse.js"
  },
  "bugs": "https://github.com/swiftbrowse/swiftbrowse/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swiftbrowse/swiftbrowse.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://steady-ember-82q7.here.now/",
  "keywords": [
    "browser",
    "automation",
    "testing",
    "e2e",
    "playwright",
    "mcp",
    "ai-agents",
    "chromium"
  ],
  "optionalDependencies": {
    "swiftbrowse-linux-x64": "0.1.2",
    "swiftbrowse-linux-arm64": "0.1.2",
    "swiftbrowse-darwin-arm64": "0.1.2",
    "swiftbrowse-darwin-x64": "0.1.2",
    "swiftbrowse-windows-x64": "0.1.2"
  }
}
